{
	"name": "@davar/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"generate-data": "bun ../scripts/generate-static-data/index.ts",
		"generate-data:ensure": "bun ./scripts/ensure-static-data.ts",
		"build": "bun install --frozen-lockfile && bun --env-file=.env ./build.ts",
		"build:dev": "EXPORT_TS2009_STATIC=1 bun --env-file=.env ./build.ts",
		"build:prod": "bun install --frozen-lockfile && bun --env-file=.env.production ./build.ts",
		"build:cf": "bun run build:prod",
		"dev": "bun ./scripts/dev-hot.ts",
		"dev:static": "bun run build:dev && bun run serve",
		"dev:hot": "bun ./scripts/dev-hot.ts",
		"upload:ts2009:r2": "bun ./scripts/upload-ts2009-to-r2.ts",
		"serve": "bun --env-file=.env ./server.ts",
		"serve:mobile": "BUN_IDLE_TIMEOUT=0 bun --env-file=.env ./server.ts",
		"test": "bun test",
		"test:static-data": "bun test src/app/services/staticData.test.js",
		"lint": "bunx --bun @biomejs/biome lint build.ts server.ts src scripts shared functions package.json tsconfig.json biome.json",
		"format": "bunx --bun @biomejs/biome format --write build.ts server.ts src scripts shared functions package.json tsconfig.json biome.json",
		"format:check": "bunx --bun @biomejs/biome format build.ts server.ts src scripts shared functions package.json tsconfig.json biome.json"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/icons-material": "7.3.9",
		"@mui/material": "7.3.9",
		"@radix-ui/react-accordion": "1.2.12",
		"@radix-ui/react-alert-dialog": "1.1.15",
		"@radix-ui/react-aspect-ratio": "1.1.8",
		"@radix-ui/react-avatar": "1.1.11",
		"@radix-ui/react-checkbox": "1.3.3",
		"@radix-ui/react-collapsible": "1.1.12",
		"@radix-ui/react-context-menu": "2.2.16",
		"@radix-ui/react-dialog": "1.1.15",
		"@radix-ui/react-dropdown-menu": "2.1.16",
		"@radix-ui/react-hover-card": "1.1.15",
		"@radix-ui/react-label": "2.1.8",
		"@radix-ui/react-menubar": "1.1.16",
		"@radix-ui/react-navigation-menu": "1.2.14",
		"@radix-ui/react-popover": "1.1.15",
		"@radix-ui/react-progress": "1.1.8",
		"@radix-ui/react-radio-group": "1.3.8",
		"@radix-ui/react-scroll-area": "1.2.10",
		"@radix-ui/react-select": "2.2.6",
		"@radix-ui/react-separator": "1.1.8",
		"@radix-ui/react-slider": "1.3.6",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-switch": "1.2.6",
		"@radix-ui/react-tabs": "1.1.13",
		"@radix-ui/react-toggle": "1.1.10",
		"@radix-ui/react-toggle-group": "1.1.11",
		"@radix-ui/react-tooltip": "1.2.8",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"date-fns": "4.1.0",
		"embla-carousel-react": "8.6.0",
		"input-otp": "1.4.2",
		"lucide-react": "1.7.0",
		"motion": "12.38.0",
		"next-themes": "0.4.6",
		"react": "19.2.3",
		"react-day-picker": "9.14.0",
		"react-dnd": "16.0.1",
		"react-dnd-html5-backend": "16.0.1",
		"react-dom": "19.2.3",
		"react-hook-form": "7.72.0",
		"react-icons": "^5.6.0",
		"react-markdown": "10.1.0",
		"react-resizable-panels": "4.7.6",
		"react-responsive-masonry": "2.7.1",
		"react-slick": "0.31.0",
		"recharts": "3.8.1",
		"remark-gfm": "4.0.1",
		"sonner": "2.0.7",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "1.4.0",
		"vaul": "1.1.2",
		"bun-plugin-tailwind": "0.1.2",
		"tailwindcss": "4.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.11",
		"@types/bun": "^1.3.14",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"typescript": "6.0.2"
	}
}
