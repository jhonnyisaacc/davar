{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["bun", "node"],
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@davar/shared/*": ["../shared/*"]
		},
		"skipLibCheck": true
	},
	"include": [
		"src",
		"scripts/**/*.ts",
		"server.ts",
		"build.ts",
		"shared/**/*.ts",
		"functions/**/*.ts",
		"../shared/**/*.ts"
	]
}
