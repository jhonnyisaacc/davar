PUBLIC_NODE_ENV=development

# Rails product API: development uses localhost; set the hosted HTTPS API in production.
PUBLIC_API_URL=http://127.0.0.1:3000

# Local TS2009 routes fall back here when data/ts2009 files are missing.
# Set to off for local files only.
# TS2009_API_ORIGIN=https://davar.bible

# Greek Besorah source is on by default in production. Set to 0 to hide it.
# PUBLIC_GREEK_PREVIEW_ENABLED=1

# Supabase TS2009 settings (template values)
# Local dev: copy this file to .env and set real values.
# Production: set these keys in Cloudflare Pages environment variables.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
