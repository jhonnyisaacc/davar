# Copy to .env in this same directory. Never commit .env.

# OpenRouter — batch translation (scripts.translate) and Greek drafts
# python -m scripts.translate run --source lexicon --to pt --dry-run
# python -m scripts.translate bench --limit 20 --fake
# python -m scripts.greek translate --dry-run
# Key: https://openrouter.ai/keys
# Live calls need credits. This pass uses --dry-run / --fake only.
OPENROUTER_API_KEY=

# Fast, cheap, large-context default. Override if you prefer another model.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional tuning. Greek CLI still defaults to small batches.
# The shared translator defaults to latency routing and no reasoning.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CONCURRENCY=3
# OPENROUTER_BATCH_CHARS=12000
# OPENROUTER_MAX_ITEMS=24
# OPENROUTER_PROVIDER_SORT=throughput
# OPENROUTER_REASONING_EFFORT=low
# OPENROUTER_TIMEOUT=180
# OPENROUTER_SESSION_ID=davar-translate
