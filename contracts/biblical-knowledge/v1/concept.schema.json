{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davar.bible/contracts/biblical-knowledge/v1/concept.schema.json",
  "title": "concept",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "concept",
        "expression"
      ]
    },
    "owner": {
      "enum": ["davar", "shaul"]
    },
    "upstream_id": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_record": {
      "type": "object"
    },
    "provenance": {
      "$ref": "https://davar.bible/contracts/biblical-knowledge/v1/common.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "id",
    "kind",
    "owner",
    "names",
    "provenance"
  ],
  "allOf": [
    {
      "if": {"properties": {"owner": {"const": "shaul"}}},
      "then": {
        "required": ["upstream_id", "source_record"],
        "properties": {"id": {"pattern": "^shaul:(concept|expression):[^:]+$"}}
      },
      "else": {"properties": {"id": {"pattern": "^davar:(concept|expression):[^:]+$"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "concept"}}},
      "then": {"properties": {"id": {"pattern": "^[^:]+:concept:"}}},
      "else": {"properties": {"id": {"pattern": "^[^:]+:expression:"}}}
    }
  ],
  "additionalProperties": false
}
