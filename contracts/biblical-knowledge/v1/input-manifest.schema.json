{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davar.bible/contracts/biblical-knowledge/v1/input-manifest.schema.json",
  "title": "Pilot input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "inputs",
    "pilots"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "davar",
              "shaul"
            ]
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fixture_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "owner",
          "repository",
          "revision",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "integer",
            "minimum": 1
          }
        ],
        "items": false,
        "minItems": 3
      }
    }
  }
}
