{
  "name": "davar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "expo start --port 8081",
    "start:clear": "bun run start --clear",
    "start:android:localhost": "bun run start --dev-client --localhost --clear",
    "ios": "expo run:ios --port 8081",
    "ios:clean": "expo prebuild --clean --platform ios --no-install && bun run ios --no-build-cache",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo run:android --port 8081",
    "android:clean": "expo prebuild --clean --platform android --no-install && bun run android",
    "android:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:5173 tcp:5173 && adb reverse tcp:3000 tcp:3000",
    "android:logs": "adb logcat | grep -Ei 'ReactNativeJS|AndroidRuntime|OkHttp|Expo|bible.davar'",
    "web": "bun run start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "bun test",
    "format": "biome format --write",
    "format:check": "biome format",
    "preflight": "bun run typecheck && bun run lint && bun run test",
    "eas": "bun x eas-cli@24.10.0",
    "build:ios": "bun run eas build --platform ios --profile production",
    "build:android": "bun run eas build --platform android --profile production",
    "build:all": "bun run eas build --platform all --profile production",
    "build:ios:local": "bun run eas build --platform ios --profile preview --local",
    "build:android:local": "bun run eas build --platform android --profile preview --local",
    "update:dev": "bun run eas update --channel development --environment development",
    "update:preview": "bun run eas update --channel preview --environment preview",
    "update:prod": "bun run eas update --channel production --environment production"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "^0.4.2",
    "@expo-google-fonts/cardo": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jost": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/suez-one": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "expo": "^57.0.24",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-mail-composer": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-circular-progress": "^1.4.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "7.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/bun": "^1.4.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
