# Local development; do not use these settings for hosted environments.
RAILS_ENV=development
DATABASE_URL=postgresql://localhost/davar_v2_development
API_PUBLIC_URL=http://localhost:3000
API_HOSTS=localhost,127.0.0.1
WEB_ORIGINS=http://localhost:3002,http://localhost:8082
AUTH_RETURN_URIS=davar://auth/callback,http://localhost:3002/commentary,http://localhost:3002/assemblies
INVITE_GATE_ENABLED=true
# Configure provider apps separately per environment. See .env.example for all names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
FREE_AI_PROVIDER=chatgpt
FREE_AI_KEY=
FREE_AI_MODEL=
PYTHON_BIN=python3
