# Local development; do not use these settings for hosted environments.
RAILS_ENV=development
DATABASE_URL=postgresql://localhost/davar_v2_development
API_PUBLIC_URL=http://localhost:3000
API_HOSTS=localhost,127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
AUTH_RETURN_URIS=davar://auth/callback,http://localhost:5173/commentary,http://localhost:5173/assemblies,http://127.0.0.1:5173/commentary,http://127.0.0.1:5173/assemblies,http://localhost:8081/auth/callback,http://127.0.0.1:8081/auth/callback
INVITE_GATE_ENABLED=true
# Configure provider apps separately per environment. See .env.example for all names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Server-side PostHog feature flags. Use the matching project token from project settings.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
# Only list providers after their connection capability has been approved.
AI_CONNECTION_PROVIDERS=
# Shared AI uses free OpenRouter models only; the API key never reaches the apps.
SHARED_OPENROUTER_MODEL=openrouter/free
SHARED_AI_DAILY_LIMIT=50
# Optional live commentary in development (including the local sandbox).
# Set the key and a free model to override simulations and personal connections.
OPENROUTER_API_KEY=
# Full OpenRouter model ID, including its provider prefix and :free suffix: provider/model:free.
OPENROUTER_MODEL=
# Ignored local corpus; rebuild explicitly from the pinned public Shaul snapshot.
COMMENTARY_CORPUS_PATH=../data/commentary/generated/corpus.json
COMMENTARY_EVIDENCE_BYTES=32768
PYTHON_BIN=python3

# Optional synthetic integrations; use api/bin/dev-sandbox for isolated defaults.
# This flag is rejected in staging/production. Leave unset for normal development.
# DAVAR_DEV_SANDBOX=1
