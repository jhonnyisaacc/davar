# Never commit real credentials. Use a separate environment manager for each hosted environment.
RAILS_ENV=development
DATABASE_URL=postgresql://localhost/davar_v2_development
API_PUBLIC_URL=http://localhost:3000
API_HOSTS=localhost,127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
AUTH_RETURN_URIS=davar://auth/callback,http://localhost:5173/commentary,http://localhost:5173/assemblies,http://127.0.0.1:5173/commentary,http://127.0.0.1:5173/assemblies,http://localhost:8081/auth/callback,http://127.0.0.1:8081/auth/callback
INVITE_GATE_ENABLED=true
PYTHON_BIN=python3
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple client secret is an operator-generated expiring signed JWT.
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
MAIL_FROM=Davar <sign-in@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Server-side PostHog feature flags. Use the matching project token from project settings.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
# Only list providers after their connection capability has been approved.
AI_CONNECTION_PROVIDERS=
# Shared AI uses free OpenRouter models only; the API key never reaches the apps.
SHARED_OPENROUTER_MODEL=openrouter/free
SHARED_AI_DAILY_LIMIT=50
# Shared server key; optionally select a separate development-only model below.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
