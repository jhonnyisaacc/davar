# Examples only. Fill these using this environment's secret manager.
# Never reuse production credentials or production personal data in staging.
RAILS_ENV=staging
DATABASE_URL=postgresql://staging-db.example.org/davar_v2_staging
API_PUBLIC_URL=https://api.staging.example.org
API_HOSTS=api.staging.example.org
WEB_ORIGINS=https://staging.example.org
AUTH_RETURN_URIS=davar://auth/callback,https://staging.example.org/commentary,https://staging.example.org/assemblies
INVITE_GATE_ENABLED=true
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
MAIL_FROM=Davar <sign-in@staging.example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Configure provider apps separately per environment. See .env.example for all names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Server-side PostHog feature flags. Use the matching project token from project settings.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
# Only list providers after their connection capability has been approved.
AI_CONNECTION_PROVIDERS=
# Shared AI uses free OpenRouter models only; the API key never reaches the apps.
SHARED_OPENROUTER_MODEL=openrouter/free
SHARED_AI_DAILY_LIMIT=50
PYTHON_BIN=python3

OPENROUTER_API_KEY=
