# Examples only. Fill these using this environment's secret manager.
# Never reuse production credentials or production personal data in staging.
RAILS_ENV=production
DATABASE_URL=postgresql://production-db.example.org/davar_v2_production
API_PUBLIC_URL=https://api.example.org
API_HOSTS=api.example.org
WEB_ORIGINS=https://example.org
AUTH_RETURN_URIS=davar://auth/callback,https://example.org/commentary,https://example.org/assemblies
INVITE_GATE_ENABLED=true
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
MAIL_FROM=Davar <sign-in@example.org>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Configure provider apps separately per environment. See .env.example for all names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
FREE_AI_PROVIDER=chatgpt
FREE_AI_KEY=
FREE_AI_MODEL=
PYTHON_BIN=python3
