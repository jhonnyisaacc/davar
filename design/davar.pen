            0,
            0,
            0
          ],
          "children": [
            {
              "type": "text",
              "id": "u7tM9e",
              "name": "Selector behavior notes",
              "fill": "$canvas-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Chapter: 280 × 280 px, eight columns. Verse: 232 × 232 px, six columns. Both reuse the navbar’s paper surface, grey well, 16 px corners, soft shadows, and translucent blue selection. The compact Find input filters immediately. Choose a number to navigate; use Escape, outside click, or the active navbar trigger to dismiss.",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "DSiqT",
              "name": "Responsive selector notes",
              "fill": "$canvas-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keep long indexes scrollable inside the square without growing the popup. Book and chapter context stays in the navbar. Hebrew mirrors the header, numeric rows, and text alignment. Interface labels are localized in English, Spanish, and Hebrew. This revision changes design only.",
              "lineHeight": 1.6,
              "fontFamily": "$font-ui",
              "fontSize": 13,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    }
