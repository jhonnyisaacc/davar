              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "v9Apjd",
              "name": "q",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Offline: bundle verse-notes JSON or WebView to shaul.vercel.app?",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 13,
