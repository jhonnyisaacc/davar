              "name": "q",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Commentary default when multiple notas share one verse.",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "lb9lF",
              "name": "q",
              "fill": "$text-primary",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Topic model: temas vs tags vs concepts — do not unify without a decision.",
